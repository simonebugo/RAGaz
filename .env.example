# Copy this file to .env and change only the settings you need.
# Leave the device empty for automatic selection, or use cpu, mps, or cuda.
EMBEDDING_DEVICE=

# LM Studio must serve this model through its OpenAI-compatible API.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3.8-27b
# Leave empty when LM Studio authentication is disabled.
LM_STUDIO_API_KEY=

# Optional cloud generation. Real API keys belong in .env, not in this example.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
